# Copy this file to .env.local for local `vercel dev` testing.
# In production, set these same names in the Vercel project's
# Settings -> Environment Variables screen (not in this file).
# Never commit real values.

# A fine-grained GitHub Personal Access Token scoped to ONLY this
# repository, with "Contents" permission set to Read and write.
GITHUB_TOKEN=

# The GitHub username/org that owns the repository.
GITHUB_OWNER=shahshubham9090

# The repository name that stores the site and uploaded images.
GITHUB_REPOSITORY=shahshubham9090.github.io

# The branch to commit uploads to. Defaults to "main" if unset.
GITHUB_BRANCH=main
